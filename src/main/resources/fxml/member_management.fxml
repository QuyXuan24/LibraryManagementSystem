<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10" style="-fx-padding: 15; -fx-background-color: #f4f6f7;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.library.controller.MemberManagementController">

    <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="QUẢN LÝ THÀNH VIÊN">
        <padding>
            <Insets bottom="10" />
        </padding>
    </Label>

    <HBox spacing="15.0" VBox.vgrow="ALWAYS">
        <children>

            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label style="-fx-font-weight: bold;" text="Tìm kiếm:" />
                        <TextField fx:id="searchField" promptText="Nhập tên, SĐT hoặc ID..." style="-fx-background-radius: 15; -fx-border-radius: 15;" HBox.hgrow="ALWAYS" />
                    </HBox>

                    <Label fx:id="messageLabel" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;" />

                    <TableView fx:id="memberTableView" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="memberIdColumn" prefWidth="80" text="Mã TV" />
                            <TableColumn fx:id="nameColumn" prefWidth="150" text="Họ tên" />
                            <TableColumn fx:id="emailColumn" prefWidth="150" text="Email" />
                            <TableColumn fx:id="phoneColumn" prefWidth="100" text="SĐT" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </children>
            </VBox>

            <VBox minWidth="300.0" prefWidth="320.0" spacing="15.0" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                <children>
                    <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2980b9;" text="THÔNG TIN CHI TIẾT" />

                    <VBox spacing="5.0">
                        <Label text="Mã Thành Viên:" />
                        <TextField fx:id="txtId" promptText="VD: TV001" />
                    </VBox>

                    <VBox spacing="5.0">
                        <Label text="Họ và Tên:" />
                        <TextField fx:id="txtName" promptText="Nhập họ tên..." />
                    </VBox>

                    <VBox spacing="5.0">
                        <Label text="Email:" />
                        <TextField fx:id="txtEmail" promptText="example@email.com" />
                    </VBox>

                    <VBox spacing="5.0">
                        <Label text="Số Điện Thoại:" />
                        <TextField fx:id="txtPhone" promptText="Nhập số điện thoại..." />
                    </VBox>

                    <Button maxWidth="Infinity" onAction="#handleClear" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-cursor: hand;" text="Làm mới Form" />

                    <Label style="-fx-padding: 10 0 0 0;" text="Chức năng:" textFill="#7f8c8d" />

                    <HBox spacing="10.0">
                        <children>
                            <Button maxWidth="Infinity" onAction="#handleAddMember" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="THÊM" HBox.hgrow="ALWAYS" />
                            <Button maxWidth="Infinity" onAction="#handleUpdateMember" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="SỬA" HBox.hgrow="ALWAYS" />
                            <Button maxWidth="Infinity" onAction="#handleDeleteMember" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="XÓA" HBox.hgrow="ALWAYS" />
                        </children>
                    </HBox>

                </children>
            </VBox>

        </children>
    </HBox>
</VBox>
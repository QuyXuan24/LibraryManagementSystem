<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?> <?import javafx.scene.layout.VBox?>

<VBox spacing="20" style="-fx-padding: 20; -fx-background-color: #f0f2f5;"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.library.controller.StatisticsController">

    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="TỔNG QUAN HỆ THỐNG" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="🔄 Cập nhật dữ liệu" onAction="#loadStatistics"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;"/>
    </HBox>

    <HBox spacing="20" alignment="CENTER">
        <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS"
              style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <Label text="TỔNG SÁCH" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
            <Label fx:id="lblTotalBooks" text="0" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
        </VBox>

        <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS"
              style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <Label text="THÀNH VIÊN" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
            <Label fx:id="lblTotalMembers" text="0" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #2980b9;"/>
        </VBox>

        <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS"
              style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <Label text="ĐANG MƯỢN" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
            <Label fx:id="lblActiveBorrows" text="0" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #e67e22;"/>
        </VBox>

        <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS"
              style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <Label text="DOANH THU PHẠT" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
            <Label fx:id="lblTotalFine" text="0 đ" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #c0392b;"/>
        </VBox>
    </HBox>

    <Separator />

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);" HBox.hgrow="ALWAYS">
            <Label text="Phân bố sách theo thể loại" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
            <PieChart fx:id="pieChart" />
        </VBox>

        <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);" HBox.hgrow="ALWAYS">
            <Label text="Top 5 Sách Mượn Nhiều Nhất" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
            <BarChart fx:id="barChart">
                <xAxis>
                    <CategoryAxis label="Tên Sách" />
                </xAxis>
                <yAxis>
                    <NumberAxis label="Lượt mượn" />
                </yAxis>
            </BarChart>
        </VBox>
    </HBox>

</VBox>
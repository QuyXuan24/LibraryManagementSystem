<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.library.controller.BorrowReturnController"
      spacing="10"
      style="-fx-padding: 15; -fx-background-color: #f4f6f7;">

    <Label text="QUẢN LÝ MƯỢN/TRẢ SÁCH"
           style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
        <padding>
            <Insets bottom="10"/>
        </padding>
    </Label>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);" HBox.hgrow="ALWAYS">
            <Label text="MƯỢN SÁCH" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #27ae60;"/>

            <VBox spacing="5">
                <Label text="Thành viên (Nhập tên hoặc mã):"/>
                <TextField fx:id="memberIdField" promptText="Gõ tên thành viên..."/>
            </VBox>

            <VBox spacing="5">
                <Label text="Sách (Nhập tiêu đề hoặc mã):"/>
                <TextField fx:id="isbnField" promptText="Gõ tên sách..."/>
            </VBox>

            <VBox spacing="5">
                <Label text="Ngày mượn (Chọn ngày cũ để test phạt):" textFill="#e67e22"/>
                <DatePicker fx:id="borrowDatePicker" promptText="Mặc định là hôm nay" maxWidth="Infinity"/>
            </VBox>

            <Button text="Mượn sách" onAction="#handleBorrowBook"
                    maxWidth="Infinity"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </VBox>

        <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);" HBox.hgrow="ALWAYS">
            <Label text="TRẢ SÁCH" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #c0392b;"/>

            <VBox spacing="5">
                <Label text="Thành viên (Nhập tên hoặc mã):"/>
                <TextField fx:id="returnMemberIdField" promptText="Gõ tên thành viên..."/>
            </VBox>

            <VBox spacing="5">
                <Label text="Sách (Nhập tiêu đề hoặc mã):"/>
                <TextField fx:id="returnIsbnField" promptText="Gõ tên sách..."/>
            </VBox>

            <Button text="Trả sách" onAction="#handleReturnBook"
                    maxWidth="Infinity"
                    style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </VBox>
    </HBox>

    <VBox spacing="10" VBox.vgrow="ALWAYS">
        <Label text="DANH SÁCH SÁCH ĐANG MƯỢN" style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #34495e;"/>

        <TableView fx:id="borrowedBooksTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colMemberId" text="Mã TV" prefWidth="80"/>
                <TableColumn fx:id="colIsbn" text="Mã Sách" prefWidth="80"/>
                <TableColumn fx:id="colBookName" text="Tên sách" prefWidth="200"/>
                <TableColumn fx:id="colBorrowDate" text="Ngày mượn" prefWidth="100"/>
                <TableColumn fx:id="colDueDate" text="Hạn trả" prefWidth="100"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>

    <Label fx:id="messageLabel" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
</VBox>